# Python
__pycache__/
*.py[cod]
.venv/
venv/

# runtime output (generated by the emulator)
/thumbnails/
# covers the user chose: DATA, not output -- the app only ever reads this folder
/covers/
/savestates/
/watches/
/screenshots/
/crashes/
# netplay.log: addresses of the people you played with -- never shipped
/logs/
/saves/
system_ram.bin
*.state
# play history (per-user: play counts, playtime, favourites)
/library.json

# user content (never distribute ROMs/BIOS)
/roms/*.ngc
/roms/*.ngp
/bios.bin
# ...and the ORIGINAL mono NGP BIOS, under every name that dump goes by. It is SNK's,
# exactly like bios.bin: the app READS one the user supplies and SHIPS none. The only
# BIOS this project distributes is hle_bios/bios_hle.bin, which is our own clean-room
# image.
/ngp_bios.*
/ngpbios.*
/bios_ngp.*
/*.ngp

# standalone-exe build (PyInstaller): keep build_exe.bat, ignore everything it generates
/build/
/release/
/dist/
# Ignore auto-generated specs, but TRACK the maintained one -- CI builds from it,
# so it must be in the repo (a fresh checkout has no other copy).
*.spec
!NgpCraftEmulator.spec

# dev-internal docs (kept in the repo for convenience, never distributed)
/DEVLOG.md
/OPEN_ITEMS.md

# native build artifacts (keep the prebuilt cpp/build/ngpc_core.dll)
/cpp/build/CMakeFiles/
/cpp/build/*.cmake
/cpp/build/CMakeCache.txt
/cpp/build/Makefile
*.o
*.obj
*.ilk
*.pdb
*.exp
*.lib

# Personal runtime settings (paths of the developer's own machine) -- never shared.
/config.ini
/settings_backup*.ini
# Debug dumps left at the root.
/cov_*.bin
# Internal notes: research and the workspace's own source index, like DEVLOG.md.
/LINK_NETPLAY_STUDY.md
/DOC_SOURCES_INDEX.md
# Review of PRs 31-33 + console measurements of memory-access costs (to act on later).
/CALAGE_ACCES_ET_PR_31_32_33.md
